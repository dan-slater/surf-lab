{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "scripts", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["$app/types", "@webgpu/types", "bun"],
		"paths": {
			"@dan-slater/map-kit": ["./node_modules/@dan-slater/map-kit/src/lib/index.ts"],
			"@dan-slater/map-kit/*": ["./node_modules/@dan-slater/map-kit/src/lib/*"]
		}
	}
}
